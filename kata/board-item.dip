# ABOUTME: The kata board's subgraph body: completes one kata exactly like complete.dip.
# ABOUTME: Adds two fail edges (ClaimNext, Handoff) so every failure still reaches Exit and the board can record it; keep the rest in step with complete.dip.

workflow CompleteKataItem
  goal: "Claim the next ready unowned kata and complete only that item with TDD and independent review."
  start: ClaimNext
  exit: Exit

  defaults
    fidelity: summary:high

  tool ClaimNext
    label: "Guard workspace and claim one kata"
    marker_grep: "^(claim-ok|queue-empty)"
    timeout: 5m
    command:
      sh "${graph.workflow_dir}/scripts/claim-next.sh"

  agent Implement
    label: "Scope and implement the selected kata"
    model: deepseek-4.1-flash
    provider: openai-compat
    goal_gate: true
    auto_status: true
    max_turns: 300
    prompt_file: prompts/implement.md

  parallel ReviewFreshEyes -> ReviewCorrectness, ReviewScope
    params:
      fan_in_policy: all

  agent ReviewCorrectness
    label: "Fresh-eyes correctness review"
    model: deepseek-4.1-flash
    provider: openai-compat
    max_turns: 100
    max_retries: 1
    retry_target: ReviewCorrectness
    prompt_file: prompts/review-correctness.md

  agent ReviewScope
    label: "Fresh-eyes scope review"
    model: glm-5.3
    provider: openai-compat
    max_turns: 100
    max_retries: 1
    retry_target: ReviewScope
    prompt_file: prompts/review-scope.md

  fan_in ReviewsApproved <- ReviewCorrectness, ReviewScope
    params:
      fan_in_policy: all

  tool CheckApprovals
    label: "Require both SHA-bound review approvals"
    marker_grep: "^approvals-ok$"
    timeout: 30s
    command:
      sh "${graph.workflow_dir}/scripts/check-approvals.sh"

  agent Repair
    label: "Apply the single allowed repair pass"
    model: deepseek-4.1-flash
    provider: openai-compat
    goal_gate: true
    auto_status: true
    max_turns: 150
    prompt_file: prompts/repair.md

  parallel ReReviewFreshEyes -> ReReviewCorrectness, ReReviewScope
    params:
      fan_in_policy: all

  agent ReReviewCorrectness
    label: "Fresh-eyes correctness re-review"
    model: deepseek-4.1-flash
    provider: openai-compat
    max_turns: 100
    max_retries: 1
    retry_target: ReReviewCorrectness
    prompt_file: prompts/review-correctness.md

  agent ReReviewScope
    label: "Fresh-eyes scope re-review"
    model: glm-5.3
    provider: openai-compat
    max_turns: 100
    max_retries: 1
    retry_target: ReReviewScope
    prompt_file: prompts/review-scope.md

  fan_in ReReviewsApproved <- ReReviewCorrectness, ReReviewScope
    params:
      fan_in_policy: all

  tool ReCheckApprovals
    label: "Require both SHA-bound re-review approvals"
    marker_grep: "^approvals-ok$"
    timeout: 30s
    command:
      sh "${graph.workflow_dir}/scripts/check-approvals.sh"

  tool CloseSelected
    label: "Land the approved task and close the kata"
    marker_grep: "^close-ok$"
    timeout: 5m
    command:
      sh "${graph.workflow_dir}/scripts/close-selected.sh"

  tool ContinueImplement
    label: "Grant one warm continue after a steady turn-limit breach"
    timeout: 10s
    command:
      sh "${graph.workflow_dir}/scripts/continue-implement.sh"

  tool Handoff
    label: "Leave failed work open for review"
    timeout: 5m
    command:
      sh "${graph.workflow_dir}/scripts/handoff-selected.sh"

  tool Exit
    label: "One-item run complete"
    timeout: 5s
    command:
      true

  edges
    ClaimNext -> Implement  on claim-ok
    ClaimNext -> Exit  on queue-empty
    # complete.dip lets a failed claim hard-fail the run; the board must complete the subgraph so
    # RecordOutcome can read ClaimNext's status and hold the board for a person.
    ClaimNext -> Exit  when ctx.outcome = fail
    Implement -> ReviewFreshEyes  when ctx.outcome = success
    Implement -> ContinueImplement  when ctx.turn_breach_class = operator_decision
    Implement -> Handoff  when ctx.outcome = fail
    ContinueImplement -> Implement  when ctx.outcome = success  restart: true
    ContinueImplement -> Handoff  when ctx.outcome = fail
    ReviewFreshEyes -> ReviewsApproved  when ctx.outcome = success
    ReviewFreshEyes -> Repair  when ctx.outcome = fail
    ReviewsApproved -> CheckApprovals
    CheckApprovals -> CloseSelected  when ctx.outcome = success
    CheckApprovals -> Repair  when ctx.outcome = fail
    Repair -> ReReviewFreshEyes  on success
    Repair -> Handoff  on fail
    ReReviewFreshEyes -> ReReviewsApproved  when ctx.outcome = success
    ReReviewFreshEyes -> Handoff  when ctx.outcome = fail
    ReReviewsApproved -> ReCheckApprovals
    ReCheckApprovals -> CloseSelected  when ctx.outcome = success
    ReCheckApprovals -> Handoff  when ctx.outcome = fail
    CloseSelected -> Exit  when ctx.outcome = success
    CloseSelected -> Handoff  when ctx.outcome = fail
    # Handoff always exits nonzero to record the failure, and a failed node never takes an
    # unconditional edge, so route it to Exit on fail explicitly; without this the body would
    # crash here and take the whole board run down with it. The bare edge below is the default
    # dippin requires on every node, and stands in for the success path Handoff never reaches.
    Handoff -> Exit  when ctx.outcome = fail
    Handoff -> Exit
