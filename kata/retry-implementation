#!/bin/sh
# ABOUTME: Prepares one stopped, turn-limited kata implementation for tracker resume.
# ABOUTME: Validates the saved claim and preserves work while backing up the checkpoint.
set -eu

fail() { printf '%s\n' "$*" >&2; exit 1; }
usage() {
  printf 'Usage: %s RUN_ID\nRun from the target Git root after stopping all tracker processes.\nPrepares only a first Implement turn-limit failure at Handoff; prints the resume command.\n' "$0"
}
[ "$#" -eq 1 ] || { usage >&2; exit 1; }
case "$1" in -h|--help) usage; exit 0 ;; esac
run_id=$1
case "$run_id" in ''|.|..|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*) fail 'invalid run ID' ;; esac
for dependency in git jq kata pgrep; do
  command -v "$dependency" >/dev/null || fail "required command is missing: $dependency"
done
stopped() {
  if pgrep -x tracker >/dev/null; then
    fail 'stop all tracker processes before preparing a retry'
  else
    result=$?
    [ "$result" -eq 1 ] || fail 'cannot inspect tracker processes'
  fi
}
stopped
pipeline_dir=$(CDPATH='' cd -- "$(dirname "$0")" && pwd -P)
workspace=$(pwd -P)
[ "$(git rev-parse --show-toplevel)" = "$workspace" ] || fail 'run from the target Git root'
run_dir="$workspace/.tracker/runs/$run_id"
checkpoint="$run_dir/checkpoint.json"
state="$run_dir/selected.json"
for required in "$checkpoint" "$state" "$run_dir/Implement/status.json" "$run_dir/ClaimNext/status.json"; do
  [ -f "$required" ] && [ ! -L "$required" ] || fail "missing or symlinked run file: $required"
done
[ "$(cd "$run_dir" && pwd -P)" = "$run_dir" ] || fail 'run directory must be inside the target workspace'

jq -e --arg run "$run_id" '
  type == "object" and .run_id == $run and .current_node == "Handoff" and
  .completed_nodes == ["ClaimNext", "Implement"] and
  .edge_selections == {ClaimNext:"Implement", Implement:"Handoff"} and
  (.context | type == "object" and all(.[]; type == "string")) and
  ([.context | keys[] | select(startswith("node.")) |
    select(startswith("node.ClaimNext.") or startswith("node.Implement.") or startswith("node.Handoff.") | not)] | length == 0) and
  all((.gate_states // {}), (.retry_counts // {}); type == "object" and
    ((keys - ["ClaimNext", "Implement", "Handoff"]) | length == 0)) and
  all(.node_outcomes, .fallback_taken, .gate_recheck_pending, .overridden_gates,
      .memo_entries; (. // {} | length) == 0) and
  ((.restart_counts // {}) | length == 0) and
  ((.validation_overrides // []) | length == 0) and
  ((.restart_count // 0) == 0) and
  ((keys - ["run_id", "current_node", "completed_nodes", "retry_counts", "context", "timestamp",
    "restart_count", "restart_counts", "edge_selections", "gate_states", "wip_refs", "bundle_identity",
    "validation_overrides", "memo_entries", "node_outcomes", "fallback_taken", "gate_recheck_pending", "overridden_gates"]) | length == 0)
' "$checkpoint" >/dev/null || fail 'checkpoint is not a first implementation handoff with a supported schema'
jq -e '.outcome == "fail" and .context_updates.turn_breach_class == "operator_decision" and
  (.context_updates.turn_limit_msg | type == "string" and length > 0)' \
  "$run_dir/Implement/status.json" >/dev/null || fail 'not an operator-decision turn-limit failure'
jq -e '.outcome == "success" and .context_updates.tool_marker == "claim-ok"' \
  "$run_dir/ClaimNext/status.json" >/dev/null || fail 'saved ClaimNext did not confirm a successful claim'
for artifact in "$run_dir"/*/ "$run_dir"/*.approved; do
  [ -e "$artifact" ] || continue
  case "$artifact" in "$run_dir/ClaimNext/"|"$run_dir/Implement/"|"$run_dir/Handoff/") ;; *) fail 'review or close artifacts already exist' ;; esac
done
jq -e 'all(.workspace, .branch, .base_commit, .actor, .issue_uid; type == "string" and length > 0)' \
  "$state" >/dev/null || fail 'invalid selected state'
saved_workspace=$(jq -r '.workspace' "$state")
[ "$(cd "$saved_workspace" && pwd -P)" = "$workspace" ] || fail 'tracker workspace changed'
branch=$(jq -r '.branch' "$state")
[ "$(git symbolic-ref --quiet --short HEAD)" = "$branch" ] || fail 'task branch changed'
base=$(jq -r '.base_commit' "$state")
case "$base" in *[!0123456789abcdefABCDEF]*) fail 'invalid base commit' ;; esac
[ "${#base}" -eq 40 ] || [ "${#base}" -eq 64 ] || fail 'invalid base commit'
git merge-base --is-ancestor "$base" HEAD || fail 'task history no longer descends from the claimed base'
uid=$(jq -r '.issue_uid' "$state")
case "$uid" in *[!0123456789ABCDEFGHJKMNPQRSTVWXYZ]*) fail 'invalid issue UID' ;; esac
[ "${#uid}" -eq 26 ] || fail 'invalid issue UID'
actor=$(jq -r '.actor' "$state")
[ "$actor" = "kata-pipeline-$run_id" ] || fail 'saved actor does not match this run'
issue_json=$(kata show --workspace "$workspace" "$uid" --json)
printf '%s' "$issue_json" | jq -e --arg uid "$uid" --arg actor "$actor" \
  '.issue.uid == $uid and .issue.status == "open" and .issue.owner == $actor' >/dev/null ||
  fail 'selected kata is no longer open and owned by this run'

# A same-directory temporary file makes replacement atomic; retain the exact original.
checkpoint_tmp=$(mktemp "$run_dir/checkpoint.json.retry.XXXXXX")
trap 'rm -f "$checkpoint_tmp"' EXIT HUP INT TERM
jq --arg state "$state" '
  .current_node = "Implement" | .completed_nodes = ["ClaimNext"] |
  .edge_selections = {ClaimNext:"Implement"} | .retry_counts = {} | .gate_states = {} |
  .restart_count = 0 |
  del(.restart_counts, .node_outcomes, .fallback_taken, .gate_recheck_pending,
      .overridden_gates, .memo_entries) |
  .context = ((.context | with_entries(select(.key | startswith("graph.")))) + {
    "node.ClaimNext.tool_stdout": ("claim-ok\nSTATE_PATH=" + $state),
    "node.ClaimNext.tool_marker": "claim-ok", "node.ClaimNext.outcome": "success"})
' "$checkpoint" >"$checkpoint_tmp"
stopped
backup=$(mktemp "$run_dir/checkpoint.json.before-retry.XXXXXX")
cp -p "$checkpoint" "$backup"
mv "$checkpoint_tmp" "$checkpoint"
printf 'Prepared implementation retry. Original checkpoint: %s\n' "$backup"
# POSIX single-quote escaping also works in the documented interactive shells.
quoted_pipeline=$(printf '%s' "$pipeline_dir/complete.dip" | sed "s/'/'\\\\''/g")
printf "Resume from this workspace:\ntracker -r %s '%s'\n" "$run_id" "$quoted_pipeline"
