#!/bin/sh
# ABOUTME: Runs the kata pipeline's deterministic graph and shell checks.
# ABOUTME: Uses temporary repositories and never touches a configured target project.
set -eu

KATA_DIR=$(CDPATH='' cd -- "$(dirname "$0")" && pwd -P)
command -v dippin >/dev/null
command -v tracker >/dev/null
dippin validate "$KATA_DIR/complete.dip"
check_json=$(dippin check --format json "$KATA_DIR/complete.dip")
printf '%s' "$check_json" | jq -e '.valid == true and .warnings == 0' >/dev/null
dippin validate "$KATA_DIR/board.dip"
check_json=$(dippin check --format json "$KATA_DIR/board.dip")
printf '%s' "$check_json" | jq -e '.valid == true and .warnings == 0' >/dev/null
dippin validate "$KATA_DIR/board-item.dip"
check_json=$(dippin check --format json "$KATA_DIR/board-item.dip")
printf '%s' "$check_json" | jq -e '.valid == true and .warnings == 0' >/dev/null
simulation_log=$(mktemp)
trap 'rm -f "$simulation_log"' EXIT
trap 'exit 130' HUP INT TERM
dippin simulate "$KATA_DIR/complete.dip" --all-paths >"$simulation_log" 2>&1
grep -F 'ClaimNext' "$simulation_log" >/dev/null
grep -F 'Repair' "$simulation_log" >/dev/null
grep -F 'ContinueImplement' "$simulation_log" >/dev/null
# The board body is complete.dip's graph plus two fail edges, so its nodes stream to the board console by
# the same names; a failed claim or handoff must still reach Exit so RecordOutcome reads the sweep instead
# of the parent run crashing mid-body. A failed node never takes an unconditional edge, and the simulator
# does not walk these fail edges, so check the source for both directly.
dippin simulate "$KATA_DIR/board-item.dip" --all-paths >"$simulation_log" 2>&1
grep -F 'ClaimNext' "$simulation_log" >/dev/null
grep -F 'Repair' "$simulation_log" >/dev/null
grep -F 'ContinueImplement' "$simulation_log" >/dev/null
grep -Eq '^[[:space:]]*ClaimNext -> Exit[[:space:]]+when ctx\.outcome = fail' "$KATA_DIR/board-item.dip" || {
  printf 'board-item.dip must end a failed claim at Exit so the board can record it\n' >&2
  exit 1
}
grep -Eq '^[[:space:]]*Handoff -> Exit[[:space:]]+when ctx\.outcome = fail' "$KATA_DIR/board-item.dip" || {
  printf 'board-item.dip must route a failed handoff to Exit so the body never crashes the board\n' >&2
  exit 1
}
dippin simulate "$KATA_DIR/board.dip" --all-paths >"$simulation_log" 2>&1
# Every route the board relies on, as dippin prints it; a renamed label or a dropped restart fails here.
# The bare RunKata edge (matched by the trailing timestamp) is the catch-all that records any body outcome.
for edge in \
  '"from":"Preflight","to":"RunKata","condition":"ctx.tool_marker = preflight-ok"' \
  '"from":"RunKata","to":"RecordOutcome","condition":"ctx.outcome = success"' \
  '"from":"RunKata","to":"RecordOutcome","timestamp"' \
  '"from":"RecordOutcome","to":"Preflight","condition":"ctx.tool_marker = sweep-again","restart":true' \
  '"from":"RecordOutcome","to":"Exit","condition":"ctx.tool_marker = board-clean"' \
  '"from":"RecordOutcome","to":"Report","condition":"ctx.tool_marker = board-needs-human"' \
  '"from":"Report","to":"MorningReview"' \
  '"from":"MorningReview","to":"Exit","label":"Done"' \
  '"from":"MorningReview","to":"Preflight","label":"Sweep again","restart":true'; do
  grep -F "$edge" "$simulation_log" >/dev/null || {
    printf 'board.dip simulation lacks the edge %s\n' "$edge" >&2
    exit 1
  }
done
# A default choice would let a closed stdin or --auto-approve answer the morning review by itself.
if grep -nE '^[[:space:]]*default:' "$KATA_DIR/board.dip"; then
  printf 'board.dip gives the morning review a default choice\n' >&2
  exit 1
fi
# With no default, --auto-approve and the TUI's Escape take the first choice, which must be Done.
grep -E '^[[:space:]]*MorningReview ->' "$KATA_DIR/board.dip" | sed -n '1p' | grep -F 'choice: done' >/dev/null || {
  printf 'board.dip must list Done as the first morning review choice\n' >&2
  exit 1
}
tracker_log=$(mktemp)
trap 'rm -f "$simulation_log" "$tracker_log"' EXIT
tracker validate "$KATA_DIR/complete.dip" >"$tracker_log" 2>&1
grep -F 'complete.dip: valid (' "$tracker_log" >/dev/null
tracker validate "$KATA_DIR/board.dip" >>"$tracker_log" 2>&1
grep -F 'board.dip: valid (6 nodes, 9 edges)' "$tracker_log" >/dev/null
tracker validate "$KATA_DIR/board-item.dip" >>"$tracker_log" 2>&1
grep -F 'board-item.dip: valid (17 nodes, 32 edges)' "$tracker_log" >/dev/null
if grep -F 'warning: unresolved condition variable' "$tracker_log" >/dev/null; then
  printf 'note - tracker static validation reports unset runtime context; real preflight checks run below\n'
fi
sh "$KATA_DIR/tests/isolation.sh"
"$KATA_DIR/tests/routes.sh"
sh "$KATA_DIR/tests/tool-commands.sh"
sh "$KATA_DIR/tests/continue.sh"
sh "$KATA_DIR/tests/handoff.sh"
"$KATA_DIR/tests/check.sh"
"$KATA_DIR/tests/approvals.sh"
"$KATA_DIR/tests/preflight.sh"
"$KATA_DIR/tests/close.sh"
sh "$KATA_DIR/tests/board-preflight.sh"
sh "$KATA_DIR/tests/board-record.sh"
sh "$KATA_DIR/tests/board.sh"
sh "$KATA_DIR/tests/board-artifacts.sh"
sh "$KATA_DIR/tests/answer.sh"
sh "$KATA_DIR/tests/report.sh"
sh "$KATA_DIR/tests/no-remote-commands.sh"
sh "$KATA_DIR/check-no-remotes" "$KATA_DIR/.."
shellcheck -x --source-path="$KATA_DIR" "$KATA_DIR/check" "$KATA_DIR/check-no-remotes" "$KATA_DIR/board-report" "$KATA_DIR/answer" "$KATA_DIR"/scripts/*.sh "$KATA_DIR"/tests/*.sh
